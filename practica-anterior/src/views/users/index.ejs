<%
const rolClass = {
  estudiante: 'bg-indigo-50 text-indigo-700',
  empresa: 'bg-amber-50 text-amber-700',
  vinculacion: 'bg-emerald-50 text-emerald-700',
};
%>
<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<main class="mx-auto w-full max-w-6xl px-4 py-10">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Administración</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Usuarios</h1>
      <p class="mt-1 text-sm text-slate-500">
        Registros de la tabla
        <code class="rounded bg-slate-200/70 px-1.5 py-0.5 text-slate-700">users</code>.
      </p>
    </div>
    <span class="rounded-full bg-indigo-50 px-4 py-1.5 text-sm font-medium text-indigo-700">
      <%= users.length %> registro<%= users.length === 1 ? '' : 's' %>
    </span>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">ID</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Nombre</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Correo</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Rol</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Carrera</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Estado</th>
            <th scope="col" class="px-6 py-3 font-semibold text-slate-600">Registro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-slate-500">
                No hay usuarios registrados. Ejecuta <code class="rounded bg-slate-100 px-1.5 py-0.5">npm run db:seed</code>.
              </td>
            </tr>
          <% } %>
          <% users.forEach((u) => { %>
            <tr class="transition-colors hover:bg-slate-50">
              <td class="px-6 py-4 font-mono text-xs text-slate-400"><%= u.id %></td>
              <td class="px-6 py-4 font-medium text-slate-900"><%= u.nombre %></td>
              <td class="px-6 py-4 text-slate-600"><%= u.correo %></td>
              <td class="px-6 py-4">
                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium capitalize <%= rolClass[u.rol] || 'bg-slate-100 text-slate-600' %>">
                  <%= u.rol %>
                </span>
              </td>
              <td class="px-6 py-4 text-slate-600"><%= u.carrera || '—' %></td>
              <td class="px-6 py-4">
                <% if (u.activo) { %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>Activo
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">
                    <span class="h-2 w-2 rounded-full bg-slate-400"></span>Inactivo
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-slate-500">
                <%= new Date(u.creado_en).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
